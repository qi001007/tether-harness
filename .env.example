# Copy to .env (gitignored) and fill in.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_MAX_TOKENS=8192
DSH_HOME=E:/遥望科技实习项目/tether/.runtime/dsh-home
TETHER_PORT=18890
TETHER_NODE_TOKEN=tether-local-2026
TETHER_DB=E:/遥望科技实习项目/tether/.runtime/controller.db
TETHER_CONTROLLER=ws://127.0.0.1:18890/ws/node
TETHER_DEVICE=DESKTOP-LOCAL
# Remote Hub mode (APP / target Node). Leave unset for local-only use.
# TETHER_CONTROLLER_URL=https://hub.example.com
# TETHER_ACCESS_TOKEN=
# TETHER_CA_FILE=
# TETHER_INSECURE_TLS=0
# Hub native surface public suffix (e.g. 8-220-198-26.sslip.io)
# TETHER_SURFACE_SUFFIX=

# Update feed. With TETHER_UPDATE_MANIFEST_URL unset the updater tries the
# <controller>/releases/manifest mirror first and GitHub only as the origin.
# TETHER_UPDATE_MANIFEST_URL=https://hub.example.com/releases/manifest
# TETHER_UPDATE_CHANNEL=stable            # stable | beta | preview
# Artifact downloads already fall back to <manifest-dir>/artifacts/<sha256> on
# the Hub. Set this to force a different mirror root for every artifact.
# TETHER_UPDATE_ARTIFACT_MIRROR=https://hub.example.com/releases/artifacts
