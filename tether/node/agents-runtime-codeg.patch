diff --git a/src/components/workspace/tether-agent-home.tsx b/src/components/workspace/tether-agent-home.tsx
new file mode 100644
index 0000000..e4b4aee
--- /dev/null
+++ b/src/components/workspace/tether-agent-home.tsx
@@ -0,0 +1,632 @@
+"use client"
+
+import { useCallback, useEffect, useMemo, useState } from "react"
+import {
+  Activity,
+  Bot,
+  ChevronDown,
+  CircleSlash,
+  MessageSquare,
+  Plus,
+  RotateCw,
+  TerminalSquare,
+  Trash2,
+} from "lucide-react"
+import { AgentIcon } from "@/components/agent-icon"
+import { WorkbenchPageTitle } from "@/components/workbench/workbench-page-title"
+import { useActiveFolder } from "@/contexts/active-folder-context"
+import { useTabActions, useTabStore } from "@/contexts/tab-context"
+import { useWorkbenchRoute } from "@/contexts/workbench-route-context"
+import { useAppWorkspaceStore } from "@/stores/app-workspace-store"
+import { useAcpAgents } from "@/hooks/use-acp-agents"
+import { useShallow } from "zustand/react/shallow"
+import { useTranslations } from "next-intl"
+import { isOpenCodeV1Release } from "@/lib/agent-version"
+import { acpUpdateAgentPreferences } from "@/lib/api"
+import type { AcpAgentInfo, AgentType, FolderDetail } from "@/lib/types"
+import { cn, randomUUID } from "@/lib/utils"
+
+/** Vendor CLI used by the "terminal" action; ACP-only adapters have no shell. */
+const AGENT_CLI: Record<string, string> = {
+  codex: "codex",
+  qoder: "qoder",
+  gemini: "gemini",
+  claude_code: "claude",
+  open_code: "opencode",
+  open_claw: "openclaw",
+  code_buddy: "codebuddy",
+  kimi_code: "kimi",
+  minimax_code: "mcode",
+  command_code: "command-code",
+  cursor: "cursor-agent",
+}
+
+/** Herdr supports these registered agent kinds through its pane agent API. */
+const HERDR_AGENT_KIND: Partial<Record<AgentType, string>> = {
+  codex: "codex",
+  claude_code: "claude",
+  gemini: "gemini",
+  open_code: "opencode",
+  cursor: "cursor",
+  kimi_code: "kimi",
+  qwen_code: "qwen",
+  qoder: "qodercli",
+}
+
+export function agentCliCommand(agentType: AgentType): string | undefined {
+  return AGENT_CLI[agentType]
+}
+
+export function TetherAgentPage() {
+  const { activeFolder } = useActiveFolder()
+  const allFolders = useAppWorkspaceStore(
+    useShallow((state) => state.allFolders)
+  )
+  const { openNewConversationTab } = useTabActions()
+  const {
+    openConversations,
+    requestedAgentType,
+    requestedProjectId,
+    requestedTargetGroup,
+  } = useWorkbenchRoute()
+  const initialAgentType = useTabStore(
+    (state) =>
+      state.tabs.find((tab) => tab.id === state.activeTabId)?.agentType ??
+      undefined
+  )
+  const selectedProject = useMemo(() => {
+    if (requestedProjectId != null) {
+      return allFolders.find(
+        (folder) =>
+          folder.id === requestedProjectId && folder.kind !== "chat"
+      ) ?? null
+    }
+    if (!activeFolder || activeFolder.kind === "chat") return null
+    return allFolders.find((folder) => folder.id === activeFolder.id) ?? null
+  }, [activeFolder, allFolders, requestedProjectId])
+
+  const handleOpenStructured = useCallback(
+    (agentType: AgentType) => {
+      if (!selectedProject) return
+      openNewConversationTab(selectedProject.id, selectedProject.path, {
+        forceAgent: agentType,
+        ...(requestedTargetGroup ? { targetGroup: requestedTargetGroup } : {}),
+      })
+      openConversations()
+    },
+    [selectedProject, requestedTargetGroup, openConversations, openNewConversationTab]
+  )
+
+  const handleOpenTerminal = useCallback(
+    (agent: AcpAgentInfo) => {
+      const command = agentCliCommand(agent.agent_type)
+      if (!command || !selectedProject) return
+      const action = new URLSearchParams({
+        tether_action: "open_cli",
+        request_id: randomUUID(),
+        agent_type: agent.agent_type,
+        cwd: selectedProject.path,
+      })
+      window.location.hash = action.toString()
+    },
+    [selectedProject]
+  )
+
+  const handleOpenHerdr = useCallback(
+    (agent: AcpAgentInfo) => {
+      if (!selectedProject || !HERDR_AGENT_KIND[agent.agent_type]) return
+      const action = new URLSearchParams({
+        tether_action: "open_herdr",
+        request_id: randomUUID(),
+        agent_type: agent.agent_type,
+        cwd: selectedProject.path,
+      })
+      window.location.hash = action.toString()
+    },
+    [selectedProject]
+  )
+
+  return (
+    <TetherAgentHome
+      initialAgentType={initialAgentType}
+      requestedAgentType={requestedAgentType ?? undefined}
+      selectedProject={selectedProject}
+      onOpenStructured={handleOpenStructured}
+      onOpenTerminal={handleOpenTerminal}
+      onOpenHerdr={handleOpenHerdr}
+    />
+  )
+}
+
+export function TetherAgentPageTitle() {
+  const t = useTranslations("SettingsShell.nav")
+  return <WorkbenchPageTitle title={t("agents")} backLabel="返回当前会话" />
+}
+
+type EnvRow = { key: string; value: string }
+
+function needsOpenCodeUpgrade(agent: AcpAgentInfo | null) {
+  return Boolean(
+    agent?.enabled &&
+      agent.available &&
+      agent.agent_type === "open_code" &&
+      isOpenCodeV1Release(agent.installed_version ?? "")
+  )
+}
+
+function statusLabel(agent: AcpAgentInfo) {
+  return agent.enabled && agent.available ? "可用" : agent.enabled ? "未安装" : "已停用"
+}
+
+function distributionLabel(value: string) {
+  switch (value) {
+    case "builtin":
+      return "内置"
+    case "npm":
+      return "npm"
+    case "system":
+      return "系统"
+    case "custom":
+      return "自定义"
+    default:
+      return value || "—"
+  }
+}
+
+function Switch({ checked, onChange }: { checked: boolean; onChange: () => void }) {
+  return (
+    <button
+      type="button"
+      role="switch"
+      aria-checked={checked}
+      onClick={onChange}
+      className={cn(
+        "relative h-[18px] w-8 shrink-0 rounded-full transition-colors",
+        checked ? "bg-[#1570ef]" : "bg-border"
+      )}
+    >
+      <span
+        className={cn(
+          "absolute top-[1px] size-4 rounded-full bg-white shadow-sm transition-all",
+          checked ? "left-[15px]" : "left-[1px]"
+        )}
+      />
+    </button>
+  )
+}
+
+export function TetherAgentHome({
+  initialAgentType,
+  requestedAgentType,
+  selectedProject,
+  onOpenStructured,
+  onOpenTerminal,
+  onOpenHerdr,
+}: {
+  initialAgentType?: AgentType
+  requestedAgentType?: AgentType
+  selectedProject: FolderDetail | null
+  onOpenStructured: (agentType: AgentType) => void
+  onOpenTerminal: (agent: AcpAgentInfo) => void
+  onOpenHerdr: (agent: AcpAgentInfo) => void
+}) {
+  const { agents, refresh } = useAcpAgents()
+  const list = useMemo(() => agents.filter((agent) => agent.enabled), [agents])
+  const [selectedType, setSelectedType] = useState<AgentType | null>(
+    initialAgentType ?? null
+  )
+  const [requestedType, setRequestedType] = useState<AgentType | null>(null)
+  useEffect(() => {
+    setRequestedType(requestedAgentType ?? null)
+    if (requestedAgentType) setSelectedType(requestedAgentType)
+  }, [requestedAgentType])
+  const selected = requestedType
+    ? (list.find((agent) => agent.agent_type === requestedType) ?? null)
+    : (list.find((agent) => agent.agent_type === selectedType) ?? list[0] ?? null)
+  const cli = selected ? AGENT_CLI[selected.agent_type] : undefined
+  const ready = Boolean(selected?.enabled && selected?.available)
+  const upgradeOpenCode = needsOpenCodeUpgrade(selected)
+  const structuredReady = ready && !upgradeOpenCode
+  const version = selected?.installed_version || selected?.registry_version || ""
+
+  const [envRows, setEnvRows] = useState<EnvRow[]>([])
+  const [configText, setConfigText] = useState("")
+  const [advanced, setAdvanced] = useState(false)
+  const [saving, setSaving] = useState(false)
+  const [note, setNote] = useState("")
+
+  useEffect(() => {
+    setEnvRows(
+      Object.entries(selected?.env || {}).map(([key, value]) => ({ key, value }))
+    )
+    setConfigText(selected?.config_json || "")
+    setAdvanced(false)
+    setNote("")
+  }, [selected?.agent_type])
+
+  const save = async (patch: { enabled?: boolean } = {}) => {
+    if (!selected || saving) return
+    const env: Record<string, string> = {}
+    for (const row of envRows) {
+      const key = row.key.trim()
+      if (key) env[key] = row.value
+    }
+    let config: string | null = configText.trim() || null
+    if (config) {
+      try {
+        JSON.parse(config)
+      } catch {
+        setNote("配置 JSON 格式不正确")
+        return
+      }
+    }
+    setSaving(true)
+    setNote("")
+    try {
+      await acpUpdateAgentPreferences(selected.agent_type, {
+        enabled: patch.enabled ?? selected.enabled,
+        env,
+        config_json: config,
+      })
+      await refresh()
+      setNote("已保存，下一次会话生效")
+    } catch (error) {
+      setNote(error instanceof Error ? error.message : String(error))
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  const updateRow = (index: number, patch: Partial<EnvRow>) => {
+    setEnvRows((rows) =>
+      rows.map((row, i) => (i === index ? { ...row, ...patch } : row))
+    )
+  }
+
+  return (
+    <div className="flex h-full min-h-0 w-full bg-background">
+      <div className="flex min-w-0 flex-1">
+        <aside className="flex w-[220px] shrink-0 flex-col border-r border-border/50 bg-background">
+          <div className="flex h-11 shrink-0 items-center gap-2 px-3.5 text-[11px] font-medium text-muted-foreground">
+            <Bot aria-hidden className="size-3.5" />
+            Agent
+            <span className="ml-auto tabular-nums">{list.length}</span>
+            <button
+              type="button"
+              title="刷新 Agent"
+              aria-label="刷新 Agent"
+              onClick={() => void refresh()}
+              className="grid size-6 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
+            >
+              <RotateCw aria-hidden className="size-3.5" />
+            </button>
+          </div>
+          <div className="min-h-0 flex-1 overflow-y-auto px-2 pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
+          {list.map((agent) => {
+            const active = selected?.agent_type === agent.agent_type
+            const available = agent.enabled && agent.available
+            return (
+              <button
+                key={agent.agent_type}
+                type="button"
+                onClick={() => {
+                  setRequestedType(null)
+                  setSelectedType(agent.agent_type)
+                }}
+                title={agent.name}
+                className={cn(
+                  "group flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-left transition-colors",
+                  active
+                    ? "bg-background text-foreground shadow-[0_1px_2px_rgba(9,30,66,.07)] ring-1 ring-black/[.04]"
+                    : "text-muted-foreground hover:bg-background/60 hover:text-foreground",
+                  !available && "opacity-60"
+                )}
+              >
+                <span className="relative grid size-6 shrink-0 place-items-center">
+                  <AgentIcon agentType={agent.agent_type} className="size-[22px]" />
+                  <span
+                    className={cn(
+                      "absolute -right-px -bottom-px size-[7px] rounded-full ring-[1.5px] ring-muted",
+                      available ? "bg-emerald-500" : "bg-amber-500"
+                    )}
+                  />
+                </span>
+                <span className="grid min-w-0 flex-1 gap-px">
+                  <span
+                    className={cn(
+                      "truncate text-xs",
+                      active ? "font-semibold" : "font-medium"
+                    )}
+                  >
+                    {agent.name}
+                  </span>
+                  {agent.installed_version ? (
+                    <span className="truncate text-[10px] text-muted-foreground">
+                      {agent.installed_version}
+                    </span>
+                  ) : null}
+                </span>
+                {needsOpenCodeUpgrade(agent) ? (
+                  <span className="shrink-0 text-[10px] text-amber-600 dark:text-amber-500">
+                    仅终端
+                  </span>
+                ) : available ? null : (
+                  <span className="shrink-0 text-[10px] text-amber-600 dark:text-amber-500">
+                    未装
+                  </span>
+                )}
+              </button>
+            )
+          })}
+          {!list.length ? (
+            <div className="px-2 py-6 text-center text-xs text-muted-foreground">
+              没有已启用的 Agent
+            </div>
+          ) : null}
+          </div>
+        </aside>
+
+      <section className="min-w-0 flex-1 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
+        {selected ? (
+          <div className="mx-auto w-full max-w-[780px] px-7 py-6">
+            <div className="flex items-start gap-3.5">
+              <span className="grid size-12 shrink-0 place-items-center rounded-xl bg-background shadow-[0_1px_3px_rgba(9,30,66,.08)] ring-1 ring-black/[.05]">
+                <AgentIcon agentType={selected.agent_type} className="size-8" />
+              </span>
+              <div className="min-w-0 flex-1">
+                <div className="flex items-center gap-2">
+                  <span className="truncate text-[19px] font-semibold leading-tight text-foreground">
+                    {selected.name}
+                  </span>
+                  <span
+                    className={cn(
+                      "inline-flex shrink-0 items-center gap-1 rounded-md px-1.5 py-0.5 text-[10.5px]",
+                      structuredReady
+                        ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
+                        : "bg-muted text-muted-foreground"
+                    )}
+                  >
+                    {!ready ? <CircleSlash aria-hidden className="size-3" /> : null}
+                    {upgradeOpenCode ? "仅终端" : statusLabel(selected)}
+                  </span>
+                </div>
+                <div className="mt-1 text-[11.5px] text-muted-foreground">
+                  {version || "—"}
+                  {selected.is_acp_adapter ? " · ACP 适配器" : " · 原生"}
+                  {" · "}
+                  {distributionLabel(selected.distribution_type)}
+                </div>
+              </div>
+              <div className="flex shrink-0 items-center gap-2 pt-1">
+                <span className="text-[11px] text-muted-foreground">启用</span>
+                <Switch
+                  checked={Boolean(selected.enabled)}
+                  onChange={() => void save({ enabled: !selected.enabled })}
+                />
+              </div>
+            </div>
+
+            <p className="mt-3 line-clamp-2 text-xs leading-5 text-muted-foreground">
+              {selected.description || "选择下面的方式开始一个新会话。"}
+            </p>
+
+            <div className="mt-4 flex flex-wrap items-center gap-2">
+              <button
+                type="button"
+                disabled={!selectedProject || !ready || !cli}
+                onClick={() => onOpenTerminal(selected)}
+                title={cli ? `在终端运行 ${cli}` : "该 Agent 没有可用的终端命令"}
+                className="inline-flex h-[34px] items-center justify-center gap-1.5 rounded-lg border border-border bg-background px-3.5 text-xs font-medium text-foreground transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                <TerminalSquare aria-hidden className="size-[15px]" />
+                终端
+              </button>
+              <button
+                type="button"
+                disabled={!selectedProject || !structuredReady}
+                onClick={() => onOpenStructured(selected.agent_type)}
+                className="inline-flex h-[34px] items-center justify-center gap-1.5 rounded-lg bg-[#1570ef] px-3.5 text-xs font-medium text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                <MessageSquare aria-hidden className="size-[15px]" />
+                结构化
+              </button>
+              <button
+                type="button"
+                disabled={
+                  !selectedProject ||
+                  !ready ||
+                  !HERDR_AGENT_KIND[selected.agent_type]
+                }
+                onClick={() => onOpenHerdr(selected)}
+                title={
+                  HERDR_AGENT_KIND[selected.agent_type]
+                    ? "在 Tether 中使用当前 Agent 打开 Herdr"
