+                    className="tether-scroll h-32 w-full resize-y rounded-lg border border-border/60 bg-muted/20 p-2.5 font-mono text-[11.5px] leading-5 text-foreground outline-none transition-colors placeholder:text-muted-foreground/50 hover:border-border focus:border-[#1570ef]"
+                  />
