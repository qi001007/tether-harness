+                >
+                  {selected.config_json ? "已配置 JSON" : "配置 JSON"}
+                  <ChevronDown
+                    aria-hidden
+                    className={cn(
+                      "size-3.5 transition-transform",
+                      advanced && "rotate-180"
+                    )}
+                  />
+                </button>
