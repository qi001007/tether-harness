+"use client"
+
+import { useEffect } from "react"
+import { useAppWorkspaceStore } from "@/stores/app-workspace-store"
+import { useTabActions } from "@/contexts/tab-context"
+import { useWorkbenchRoute } from "@/contexts/workbench-route-context"
+import type { AgentType } from "@/lib/types"
+
+/** Tether home agent ids → Codeg built-in agent types. */
+const AGENT_ALIASES: Record<string, string> = {
+  claude: "claude_code",
+  opencode: "open_code",
+  openclaw: "open_claw",
+  codebuddy: "code_buddy",
+  kimi: "kimi_code",
+  minimax: "minimax_code",
+  "command-code": "command_code",
+}
+
+/**
+ * Bridge for the Tether host page embedding this workspace: the host posts
+ * `{type:"tether:new-session", id, agent}` when the user picks an agent on the
+ * Tether home, and this opens a draft conversation for that agent on the
+ * active folder. The host retries until it sees `tether:new-session-ack`; the
+ * id dedupe keeps those retries from opening more than one tab.
+ */
+export function TetherSessionBridge() {
+  const { openNewConversationTab } = useTabActions()
+  const { openConversations } = useWorkbenchRoute()
+
+  useEffect(() => {
+    const seen = new Set<string>()
+    let pending: {
+      id: string
+      agent: string
+      source: WindowProxy | null
+    } | null = null
+    let unsubscribe: (() => void) | null = null
+    let expiry: ReturnType<typeof setTimeout> | null = null
+
+    const clearPending = () => {
+      if (unsubscribe) {
+        unsubscribe()
+        unsubscribe = null
+      }
+      if (expiry) {
+        clearTimeout(expiry)
+        expiry = null
+      }
+    }
+
+    const apply = () => {
+      if (!pending) return
+      const store = useAppWorkspaceStore.getState()
+      const folders = store.allFolders
+      if (!folders.length) return
+      const target =
+        folders.find((folder) => folder.id === store.activeFolderId) ?? folders[0]
+      const request = pending
+      pending = null
+      clearPending()
+      const raw = request.agent
+      const agent = AGENT_ALIASES[raw] ?? raw
+      openConversations()
+      openNewConversationTab(
+        target.id,
+        target.path,
+        agent ? { forceAgent: agent as AgentType } : undefined
+      )
+      request.source?.postMessage(
+        { type: "tether:new-session-ack", id: request.id },
+        "*"
+      )
+    }
+
+    const onMessage = (event: MessageEvent) => {
+      const data = event.data
+      if (!data || typeof data !== "object" || data.type !== "tether:new-session") {
+        return
+      }
+      const id = String((data as { id?: unknown }).id ?? "")
+      if (id) {
+        if (seen.has(id)) return
+        seen.add(id)
+      }
+      pending = {
+        id,
+        agent: String((data as { agent?: unknown }).agent ?? ""),
+        source: event.source as WindowProxy | null,
+      }
+      apply()
+      if (pending) {
+        if (!unsubscribe) {
+          unsubscribe = useAppWorkspaceStore.subscribe(apply)
+        }
+        if (expiry) clearTimeout(expiry)
+        expiry = setTimeout(() => {
+          pending = null
+          clearPending()
+        }, 10000)
+      }
+    }
+
+    window.addEventListener("message", onMessage)
+    return () => {
+      window.removeEventListener("message", onMessage)
+      clearPending()
+    }
+  }, [openNewConversationTab, openConversations])
+
+  return null
+}
