+
+function distributionLabel(value: string) {
+  switch (value) {
+    case "builtin":
+      return "内置"
+    case "npm":
+      return "npm"
+    case "system":
+      return "系统"
+    case "custom":
+      return "自定义"
+    default:
+      return value || "—"
+  }
