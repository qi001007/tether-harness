-          console.warn("[Pet] toggle panel failed:", err)
-        )
-      }}
-      className={[
-        "absolute right-0.5 top-0.5 z-10 flex h-5 min-w-[1.25rem] cursor-pointer",
-        "items-center justify-center gap-0.5 rounded-full px-1 text-3xs font-semibold",
