{
  "name": "tether-dsh-surface",
  "version": "0.2.4",
  "description": "Publishes the installed DSH native web surface to Tether",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
