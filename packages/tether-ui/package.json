{
  "name": "tether-ui",
  "version": "0.1.0",
  "description": "Shared Tether React UI for the DSH plugin, Electron APP and WebUI",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./app": "./src/app.js",
    "./hosts/web": "./src/hosts/web.js",
    "./hosts/dsh": "./src/hosts/dsh.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "build:web": "node scripts/build-web.mjs",
    "serve": "node web/serve.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "MIT"
}
